{
  "name": "@lernapps/practice",
  "version": "0.0.0",
  "description": "The assistant's side of lernapps practice: the plan template and the skills with which a creator's AI assistant builds an app for an occasion (a class test, a cover lesson), which the creator submits as a ZIP file in an issue; documentation at https://lernapps.net/practice/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lernapps/practice.git"
  },
  "bin": {
    "lernapps-practice": "./bin/lernapps-practice.mjs"
  },
  "files": [
    "bin",
    "dist/skills",
    "guidance/plan-template.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./guidance/plan-template.md": "./guidance/plan-template.md"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "scripts": {
    "build": "./scripts/build.sh",
    "check": "site-check --site /practice/",
    "test": "node --test --test-reporter=spec \"test/*.test.ts\"",
    "try": "node scripts/try.ts",
    "prepack": "node scripts/dist-skills.ts"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "devDependencies": {
    "@doctc/arc42": "0.38.0",
    "@lernapps/site": "github:lernapps/lernapps.github.io#faf3dc3b9b61efc541fc08343e9e2e29e6b7f845",
    "marked": "18.1.3"
  },
  "dependencies": {
    "@lernapps/tooling": "0.11.5"
  },
  "lernapps": {
    "planTemplate": "guidance/plan-template.md"
  }
}
